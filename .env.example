# =========================================================================
# QuantNexa — Multi-AI-Agent Quantitative Platform Configuration Template
# =========================================================================
# Copy this file to '.env' and populate your authorized API keys.
# Never commit your actual '.env' file with secret keys to version control.

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Database Connection (SQLite default)
DATABASE_URL=sqlite:///investments.db

# Indian Market Data Provider (Upstox API)
# Optional: If not provided, QuantNexa falls back to verified yfinance market feeds
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=https://127.0.0.1:8501/

# US Market Data Providers (Finnhub, Alpha Vantage, Polygon)
# Optional: Populated when authorized enterprise feeds are licensed
FINNHUB_API_KEY=your_finnhub_api_key_here
ALPHA_VANTAGE_API_KEY=your_alphavantage_api_key_here
POLYGON_API_KEY=your_polygon_api_key_here

# News Intelligence API
# Optional: For specialized institutional news endpoints
NEWS_API_KEY=your_news_api_key_here

# Risk & Trading Execution Safety Controls
LIVE_EXECUTION_ENABLED=false
MAX_POSITION_RISK_PCT=1.5
DEFAULT_PAPER_CASH=100000.0
